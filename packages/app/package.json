{
  "name": "gaunt-sloth",
  "version": "2.0.0-beta.6",
  "description": "",
  "license": "MIT",
  "author": "Andrew Kondratev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pukeko-robotics/gaunt-sloth.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/pukeko-robotics/gaunt-sloth/issues"
  },
  "homepage": "https://github.com/pukeko-robotics/gaunt-sloth#readme",
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc"
  },
  "bin": {
    "gaunt-sloth": "cli.js",
    "gsloth": "cli.js",
    "gth": "cli.js"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@gaunt-sloth/agent": "workspace:*",
    "@gaunt-sloth/batch": "workspace:*",
    "@gaunt-sloth/core": "workspace:*",
    "@gaunt-sloth/eval-reporter-junit": "workspace:*",
    "@gaunt-sloth/review": "workspace:*",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/core": "^1.2.9",
    "@langchain/deepseek": "^1.1.10",
    "@langchain/google": "^0.2.3",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.10",
    "@langchain/openrouter": "^0.4.10",
    "@langchain/xai": "^1.4.10",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.0.4",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0"
  },
  "imports": {
    "#src/*.js": "./dist/*.js"
  },
  "//exports": "This package is the fat CLI, not a library: no `.` entry (a bare import has never resolved) and no deep-path exports (the B4 shim tree is gone; nothing imports `gaunt-sloth/*` — embed via @gaunt-sloth/{core,agent,review} instead). `./package.json` stays readable for tooling.",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "./dist/*",
    "cli.js",
    ".gsloth.*.md"
  ],
  "publishConfig": {
    "tag": "beta"
  }
}
