/node_modules/
/dist/
# Where vitest's configured v8 coverage reporters write. eslint's globalIgnores and
# pnpmOverridesGate's SKIP_DIRS already treat it as generated output; git did not, which matters
# now that the repository-wide gates cover untracked files (OPS-105) — an unignored generated tree
# is one they would judge, so a local coverage run would have made them report files nobody wrote.
/coverage/
.npmrc
.npmrc.bk
/packages/*/dist/
/packages/*/node_modules/
/packages/*/tsconfig.tsbuildinfo
/req/
/gth_*
/packages/app/integration-tests/workdir/gth_*
/packages/app/integration-tests/workdir/testreview.md
/packages/app/integration-tests/workdir/.gsloth.config.json
/packages/app/integration-tests/workdir/it-history.db*
# Per-run scratch dirs created by the `it ollama xx-small` tier (marker/synthesis cases).
# Scoped to the xxs-* prefix so the tracked fixtures alongside them (.aiignore,
# filewithbadcode.js, image.png, …) are unaffected.
/packages/app/integration-tests/workdir/xxs-*/
/packages/app/integration-tests/workdir-with-profiles/.gsloth/gth_*
/packages/app/integration-tests/workdir-with-profiles/testreview.md
/packages/app/integration-tests/workdir-with-profiles/.gsloth.config.json
/packages/app/integration-tests/workdir-with-profiles/**/.gsloth.config.json
/docs-generated
.junie
.idea
.claude/settings.local.json
*.iml
.gsloth/.gsloth-settings/jira/
.gsloth/gth_*
/gaunt-sloth.log
test-session.log
test.log
/vitest-it.config.d.ts
/vitest-it.config.js
/vitest-it.config.js.map
out/*
# OPS-41: where the evals workflow (and the same command run locally) writes results.json /
# results.xml. Ephemeral in CI; ignored here so a local gate run does not dirty the tree.
/eval-out*/
briefs/*
req
readonly

# tui-test (Stage D PTY e2e) transpiled cache
packages/*/tui-e2e/.tui-test/

# Scratch dirs the type-checking specs (core's barrel type surface, the app's discovery config
# agreement) write their probes in. They live inside the package because a probe resolves that
# package's imports, which only works from there; the specs remove them, so a surviving one means a
# run was killed.
/packages/*/.type-probe-*/

# Scratch dir the weakening-table totality spec type-checks its copy of src/ in. Inside the package
# for the same reason — the copied sources resolve their imports by walking up into
# packages/core/node_modules; the spec removes it, so a surviving one means a run was killed.
/packages/core/.hint-probe-*/

# OPS-8: per-worktree port allocation (generated by scripts/alloc-ports.mjs)
.env
